@model NationalCountyMeet.Web.Models.County

@{
    ViewData["Title"] = "Details";
    Layout = "_SubLayout";
}

<form>
    <div class="row">
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.CountyName)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.CountyName)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.CountyCapital)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.CountyCapital)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.CountyRegion)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.CountyRegion)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.YearEstablished)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.YearEstablished)
                </dd>
            </dl>
        </div>
    </div>
</form>


