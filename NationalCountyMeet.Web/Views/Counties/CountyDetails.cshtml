@model NationalCountyMeet.Web.Models.County

@{
    ViewData["Title"] = "Details";
    Layout = "_SubLayout";
}

<div class="card">
    <div class="container-fluid dashboard-content">
        <div class="row">
            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                <h2 class="text-primary text-uppercase mb-3">County Details</h2>
                <div class="row -col-12 p-3">
                    <div class="btn-group" role="group" aria-label="Basic example">
                        <a asp-action="Index" class="btn btn-dark"><i class="fas fa-arrow-circle-left"></i>&nbsp;Back to List</a>
                        <a asp-action="DeleteCountyRecord" asp-route-id="@Model.CountyId" class="btn btn-danger"><i class="far fa-times-circle"></i>&nbsp;Delete</a>
                        <a asp-action="EditCountyRecord" class="btn btn-success" asp-route-id="@Model?.CountyId"><i class="far fa-edit"></i>&nbsp;Edit</a>
                    </div>
                </div>
                <form>
                    <div class="row">
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">
                                    @Html.DisplayNameFor(model => model.CountyName)
                                </dt>
                                <dd class="col-sm-8">
                                    @Html.DisplayFor(model => model.CountyName)
                                </dd>
                                <dt class="col-sm-4">
                                    @Html.DisplayNameFor(model => model.CountyCapital)
                                </dt>
                                <dd class="col-sm-8">
                                    @Html.DisplayFor(model => model.CountyCapital)
                                </dd>
                                <dt class="col-sm-4">
                                    @Html.DisplayNameFor(model => model.CountyRegion)
                                </dt>
                                <dd class="col-sm-8">
                                    @Html.DisplayFor(model => model.CountyRegion)
                                </dd>
                                <dt class="col-sm-4">
                                    @Html.DisplayNameFor(model => model.YearEstablished)
                                </dt>
                                <dd class="col-sm-8">
                                    @Html.DisplayFor(model => model.YearEstablished)
                                </dd>
                            </dl>
                        </div>
                        <div class="col-md-6 border">
                            <div class="card-body text-center">
                                <!-- .user-avatar -->
                                <a class="user-avatar user-avatar-floated user-avatar-xl">
                                    <img src="@Model.CountyFlagPhotoUrl" alt="User Avatar" class="rounded-circle user-avatar-xl">
                                </a>
                                <!-- /.user-avatar -->
                                <h3 class="card-title mb-2">
                                    <a href="user-profile.html">NAME</a>
                                </h3>
                                <h6 class="card-subtitle text-muted mb-3">EMAIL</h6>
                                <!-- grid row -->
                                <div class="row">
                                    <!-- grid column -->
                                    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                                        <!-- .metric -->
                                        <div class="metric">
                                            <h6 class="metric-value"> 54 </h6>
                                            <p class="metric-label"> Total Goals </p>
                                        </div>
                                        <!-- /.metric -->
                                    </div>
                                    <!-- /grid column -->
                                    <!-- grid column -->
                                    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                                        <!-- .metric -->
                                        <div class="metric">
                                            <h6 class="metric-value"> 53 </h6>
                                            <p class="metric-label"> Total Assists </p>
                                        </div>
                                        <!-- /.metric -->
                                    </div>
                                    <!-- /grid column -->
                                    <!-- grid column -->
                                    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                                        <!-- .metric -->
                                        <div class="metric">
                                            <h6 class="metric-value"> 2 </h6>
                                            <p class="metric-label"> Games Played </p>
                                        </div>
                                        <!-- /.metric -->
                                    </div>
                                    <!-- /grid column -->
                                </div>
                                <!-- /grid row -->
                            </div>
                        </div>
                    </div>
                </form>
                @* <div>
                    <a asp-action="Index" class="btn btn-dark"><i class="fas fa-arrow-circle-left"></i>&nbsp;Back to List</a>
                    <a asp-action="DeleteCountyRecord" asp-route-id="@Model.CountyId" class="btn btn-danger"><i class="far fa-times-circle"></i>&nbsp;Delete</a>
                    <a asp-action="EditCountyRecord" class="btn btn-success" asp-route-id="@Model?.CountyId"><i class="far fa-edit"></i>&nbsp;Edit</a>
                </div> *@
            </div>
        </div>
    </div>
</div>
