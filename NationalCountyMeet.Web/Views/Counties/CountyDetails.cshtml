@model NationalCountyMeet.Web.Models.County

@{
    ViewData["Title"] = "Details";
    Layout = "_SubLayout";
    int Counter = 1;
}

<div class="card">
    <div class="container-fluid dashboard-content">
        <div class="row">
            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                <h2 class="text-primary text-uppercase mb-3">County Details</h2>
                <div class="row -col-12 p-3">
                    <div class="btn-group" role="group" aria-label="Basic example">
                        <a asp-action="Index" class="btn btn-dark"><i class="fas fa-arrow-circle-left"></i>&nbsp;Back to List</a>
                        <a asp-action="DeleteCountyRecord" asp-route-id="@Model.CountyId" class="btn btn-danger"><i class="far fa-times-circle"></i>&nbsp;Delete</a>
                        <a asp-action="EditCountyRecord" class="btn btn-success" asp-route-id="@Model?.CountyId"><i class="far fa-edit"></i>&nbsp;Edit</a>
                    </div>
                </div>
                <form>
                    <div class="row">
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">
                                    @Html.DisplayNameFor(model => model.CountyName)
                                </dt>
                                <dd class="col-sm-8">
                                    @Html.DisplayFor(model => model.CountyName)
                                </dd>
                                <dt class="col-sm-4">
                                    @Html.DisplayNameFor(model => model.CountyCapital)
                                </dt>
                                <dd class="col-sm-8">
                                    @Html.DisplayFor(model => model.CountyCapital)
                                </dd>
                                <dt class="col-sm-4">
                                    @Html.DisplayNameFor(model => model.CountyRegion)
                                </dt>
                                <dd class="col-sm-8">
                                    @Html.DisplayFor(model => model.CountyRegion)
                                </dd>
                                <dt class="col-sm-4">
                                    @Html.DisplayNameFor(model => model.YearEstablished)
                                </dt>
                                <dd class="col-sm-8">
                                    @Html.DisplayFor(model => model.YearEstablished)
                                </dd>
                            </dl>
                        </div>
                        <div class="col-md-6 border">
                            <div class="card-body text-center">
                                <!-- .user-avatar -->
                                <a class="user-avatar user-avatar-floated user-avatar-xl">
                                    <img src="@Model.CountyFlagPhotoUrl" alt="User Avatar" class="rounded-circle user-avatar-xl">
                                </a>
                                <!-- /.user-avatar -->
                                <h3 class="card-title mb-2">
                                    <a href="user-profile.html">NAME</a>
                                </h3>
                                <h6 class="card-subtitle text-muted mb-3">EMAIL</h6>
                                <!-- grid row -->
                                <div class="row">
                                    <!-- grid column -->
                                    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                                        <!-- .metric -->
                                        <div class="metric">
                                            <h6 class="metric-value"> 54 </h6>
                                            <p class="metric-label"> Total Goals </p>
                                        </div>
                                        <!-- /.metric -->
                                    </div>
                                    <!-- /grid column -->
                                    <!-- grid column -->
                                    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                                        <!-- .metric -->
                                        <div class="metric">
                                            <h6 class="metric-value"> 53 </h6>
                                            <p class="metric-label"> Total Assists </p>
                                        </div>
                                        <!-- /.metric -->
                                    </div>
                                    <!-- /grid column -->
                                    <!-- grid column -->
                                    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                                        <!-- .metric -->
                                        <div class="metric">
                                            <h6 class="metric-value"> 2 </h6>
                                            <p class="metric-label"> Games Played </p>
                                        </div>
                                        <!-- /.metric -->
                                    </div>
                                    <!-- /grid column -->
                                </div>
                                <!-- /grid row -->
                            </div>
                        </div>
                    </div>
                </form>
                <div class="row col-12 mt-3">
                    <div class="col-8">
                        <div b-excgvkapwk="">
                            <div b-excgvkapwk="" class="card">
                                <h5 b-excgvkapwk="" class="card-header">Current Player Listing</h5>
                                <div b-excgvkapwk="" class="card-body p-0">
                                    <div b-excgvkapwk="" class="table-responsive">
                                        <table b-excgvkapwk="" class="table">
                                            <thead b-excgvkapwk="" class="bg-light">
                                                <tr b-excgvkapwk="" class="border-0">
                                                    @* <th b-excgvkapwk="" class="border-0">No.</th> *@
                                                    <th b-excgvkapwk="" class="border-0"></th>
                                                    <th b-excgvkapwk="" class="border-0">Full Name</th>
                                                    <th b-excgvkapwk="" class="border-0">Age</th>
                                                    <th b-excgvkapwk="" class="border-0">Jersey No.</th>
                                                    <th b-excgvkapwk="" class="border-0">Position</th>
                                                </tr>
                                            </thead>
                                            <tbody b-excgvkapwk="">
                                                @foreach (var player in Model.Players)
                                                {
                                                    <tr b-excgvkapwk="">
                                                        <td b-excgvkapwk="">
                                                            <div b-excgvkapwk="" class="m-r-10"><img b-excgvkapwk="" src="@player.PlayerPhotoUrl" alt="user" class="rounded" width="35" height="35"></div>
                                                        </td>
                                                        <td b-excgvkapwk="">
                                                            <a asp-controller="Players" asp-route-id="@player.PlayerId" asp-action="Details">
                                                                @player.FullName
                                                            </a>
                                                        </td>
                                                        <td b-excgvkapwk="">
                                                            @player.DateOfBirth
                                                        </td>
                                                        <td b-excgvkapwk="">
                                                            @player.JerseyNumber
                                                        </td>
                                                        <td b-excgvkapwk="">
                                                            @player.PlayerPosition
                                                        </td>
                                                    </tr>
                                                }
                                                <tr b-excgvkapwk="">
                                                    <td b-excgvkapwk="" colspan="9"><a b-excgvkapwk="" href="#" class="btn btn-outline-light float-right">View Historical Players</a></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 bg-black">
                        <div b-excgvkapwk="">
                            <div b-excgvkapwk="" class="card">
                                <h5 b-excgvkapwk="" class="card-header">County Official Listing</h5>
                                <div b-excgvkapwk="" class="card-body p-0">
                                    <div b-excgvkapwk="" class="table-responsive">
                                        <table b-excgvkapwk="" class="table">
                                            <thead b-excgvkapwk="" class="bg-light">
                                                <tr b-excgvkapwk="" class="border-0">
                                                    <th b-excgvkapwk="" class="border-0"></th>
                                                    <th b-excgvkapwk="" class="border-0">Full Name</th>
                                                    <th b-excgvkapwk="" class="border-0">Contact</th>
                                                    <th b-excgvkapwk="" class="border-0">Position</th>
                                                </tr>
                                            </thead>
                                            <tbody b-excgvkapwk="">
                                            <tbody b-excgvkapwk="">
                                                    @foreach (var official in Model.TeamOfficial)
                                                    {
                                                    <tr b-excgvkapwk="">
                                                        <td b-excgvkapwk="">
                                                            <div b-excgvkapwk="" class="m-r-10"><img b-excgvkapwk="" src="@official.TeamOfficialPhotoUrl" alt="user" class="rounded" width="35" height="35"></div>
                                                        </td>
                                                        <td b-excgvkapwk="">
                                                            <a asp-controller="TeamOfficials" asp-route-id="@official.TeamOfficialId" asp-action="TeamOfficialsDetails">
                                                                 @official.FullName
                                                            </a>
                                                        </td>
                                                        <td b-excgvkapwk="">
                                                            @official.Contact
                                                        </td>
                                                        <td b-excgvkapwk="">
                                                                @official.Official
                                                        </td>
                                                    </tr>
                                                    }
                                                <tr b-excgvkapwk="">
                                                    <td b-excgvkapwk="" colspan="9"><a b-excgvkapwk="" href="#" class="btn btn-outline-light float-right">View Historical Players</a></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
