@* @model NationalCountyMeet.Web.Models.Fixture *@
@model NationalCountyMeet.Web.Models.ViewModels.FixtureVM

@{
    ViewData["Title"] = "Details";
    Layout = "_SubLayout";
    int Counter = 1;
}

<div class="card">
    <div class="container-fluid dashboard-content">
        <div class="row">
            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                <h2 class="text-primary mb-3">
                    Fixture: @String.Format("{0} vs {1}", Model.HomeTeamName, Model.AwayTeamName)
                </h2>
                <div class="row -col-12 p-3">
                    <div class="btn-group" role="group" aria-label="Basic example">
                        <a asp-action="Index" class="btn btn-dark"><i class="fas fa-arrow-circle-left"></i>&nbsp;Back to List</a>
                        <a asp-action="DeleteFixture" asp-route-id="@Model.FixtureId" class="btn btn-danger"><i class="far fa-times-circle"></i>&nbsp;Delete</a>
                        <a asp-action="EditFixture" class="btn btn-success" asp-route-id="@Model?.FixtureId"><i class="far fa-edit"></i>&nbsp;Edit</a>
                    </div>
                </div>
                <form>
                    <div class="row">
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">
                                    @Html.DisplayNameFor(model => model.MatchDate)
                                </dt>
                                <dd class="col-sm-8">
                                    @Html.DisplayFor(model => model.MatchDate)
                                </dd>
                                <dt class="col-sm-4">
                                    @Html.DisplayNameFor(model => model.StartTime)
                                </dt>
                                <dd class="col-sm-8">
                                    @Html.DisplayFor(model => model.StartTime)
                                </dd>
                                <dt class="col-sm-4">
                                    @Html.DisplayNameFor(model => model.CenterOfficialId)
                                </dt>
                                <dd class="col-sm-8">
                                    @Html.DisplayFor(model => model.CenterOfficialName)
                                </dd>
                                <dt class="col-sm-4">
                                    @Html.DisplayNameFor(model => model.FirstLinesmanId)
                                </dt>
                                <dd class="col-sm-8">
                                    @Html.DisplayFor(model => model.FirstLinesmaneName)
                                </dd>
                                <dt class="col-sm-4">
                                    @Html.DisplayNameFor(model => model.SecondLinesmanId)
                                </dt>
                                <dd class="col-sm-8">
                                    @Html.DisplayFor(model => model.SecondLinesmanName)
                                </dd>
                                <dt class="col-sm-4">
                                    @Html.DisplayNameFor(model => model.FourthOfficialId)
                                </dt>
                                <dd class="col-sm-8">
                                    @Html.DisplayFor(model => model.FourthOfficialName)
                                </dd>
                                <dt class="col-sm-4">
                                    @Html.DisplayNameFor(model => model.VenueId)
                                </dt>
                                <dd class="col-sm-8">
                                    @Html.DisplayFor(model => model.VenueName)
                                </dd>
                                <dt class="col-sm-4">
                                    @Html.DisplayNameFor(model => model.RoundId)
                                </dt>
                                <dd class="col-sm-8">
                                    @Html.DisplayFor(model => model.RoundName)
                                </dd>
                            </dl>
                        </div>
                        <div class="col-md-6 border">
                            <div class="card-body text-center">
                                <!-- .user-avatar -->
                                <a class="user-avatar user-avatar-floated user-avatar-xl">
                                    <img src="@Model.VenuePhotoUrl" alt="User Avatar" class="rounded-circle user-avatar-xl">
                                </a>
                                <!-- /.user-avatar -->
                                <h3 class="card-title mb-2">
                                    <a href="user-profile.html">
                                        @Model.VenueName
                                    </a>
                                </h3>
                                <h6 class="card-subtitle text-muted mb-3">
                                   
                                </h6>
                                <!-- grid row -->
                                <div class="row">
                                    <!-- grid column -->
                                    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                                        <!-- .metric -->
                                        <div class="metric">
                                            <h6 class="metric-value"> 54 </h6>
                                            <p class="metric-label"> Total Goals </p>
                                        </div>
                                        <!-- /.metric -->
                                    </div>
                                    <!-- /grid column -->
                                    <!-- grid column -->
                                    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                                        <!-- .metric -->
                                        <div class="metric">
                                            <h6 class="metric-value"> 53 </h6>
                                            <p class="metric-label"> Total Assists </p>
                                        </div>
                                        <!-- /.metric -->
                                    </div>
                                    <!-- /grid column -->
                                    <!-- grid column -->
                                    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                                        <!-- .metric -->
                                        <div class="metric">
                                            <h6 class="metric-value"> 2 </h6>
                                            <p class="metric-label"> Games Played </p>
                                        </div>
                                        <!-- /.metric -->
                                    </div>
                                    <!-- /grid column -->
                                </div>
                                <!-- /grid row -->
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>