@model NationalCountyMeet.Web.Models.MatchVenue

@{
    ViewData["Title"] = "Details";
    Layout = "_SubLayout";
}

<div class="card">
    <div class="container-fluid dashboard-content">
        <div class="row">
            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                <h2 class="text-primary text-uppercase mb-3">County Details</h2>
                <form>
                    <div class="row">
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">
                                    @Html.DisplayNameFor(model => model.VenueName)
                                </dt>
                                <dd class="col-sm-8">
                                    @Html.DisplayFor(model => model.VenueName)
                                </dd>
                                <dt class="col-sm-4">
                                    @Html.DisplayNameFor(model => model.Capacity)
                                </dt>
                                <dd class="col-sm-8">
                                    @Html.DisplayFor(model => model.Capacity)
                                </dd>
                                <dt class="col-sm-4">
                                    @Html.DisplayNameFor(model => model.Location)
                                </dt>
                                <dd class="col-sm-8">
                                    @Html.DisplayFor(model => model.Location)
                                </dd>
                            </dl>
                        </div>
                        <div class="col-md-6 border">
                            <div class="card-body text-center">
                                <!-- .user-avatar -->
                                <a href="user-profile.html" class="user-avatar user-avatar-floated user-avatar-xl">
                                    <img src="" alt="User Avatar" class="rounded-circle user-avatar-xl">
                                </a>
                                <!-- /.user-avatar -->
                                <h3 class="card-title mb-2">
                                    <a href="user-profile.html">NAME</a>
                                </h3>
                                <h6 class="card-subtitle text-muted mb-3">EMAIL</h6>
                                <!-- grid row -->
                                <div class="row">
                                    <!-- grid column -->
                                    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                                        <!-- .metric -->
                                        <div class="metric">
                                            <h6 class="metric-value"> 54 </h6>
                                            <p class="metric-label"> Total Goals </p>
                                        </div>
                                        <!-- /.metric -->
                                    </div>
                                    <!-- /grid column -->
                                    <!-- grid column -->
                                    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                                        <!-- .metric -->
                                        <div class="metric">
                                            <h6 class="metric-value"> 53 </h6>
                                            <p class="metric-label"> Total Assists </p>
                                        </div>
                                        <!-- /.metric -->
                                    </div>
                                    <!-- /grid column -->
                                    <!-- grid column -->
                                    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                                        <!-- .metric -->
                                        <div class="metric">
                                            <h6 class="metric-value"> 2 </h6>
                                            <p class="metric-label"> Games Played </p>
                                        </div>
                                        <!-- /.metric -->
                                    </div>
                                    <!-- /grid column -->
                                </div>
                                <!-- /grid row -->
                            </div>
                        </div>
                    </div>
                </form>
                <div>
                    <a asp-action="Index" class="btn btn-dark"><i class="fas fa-arrow-circle-left"></i>&nbsp;Back to List</a>
                    <a asp-action="DeleteMatchVenue" asp-route-id="@Model.MatchVenueId" class="btn btn-danger"><i class="far fa-times-circle"></i>&nbsp;Delete</a>
                    <a asp-action="EditVenueRecord" class="btn btn-success" asp-route-id="@Model?.MatchVenueId"><i class="far fa-edit"></i>&nbsp;Edit</a>
                </div>
            </div>
        </div>
    </div>
</div>