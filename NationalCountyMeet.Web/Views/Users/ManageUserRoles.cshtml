@using NationalCountyMeet.Web.Models.Others
@model List<NationalCountyMeet.Web.Models.ViewModels.UserRolesVM>

@{
    ViewData["Title"] = "Delete";
    Layout = "_SubLayout";
    var userId = ViewBag.userId;
}

<div class="card">
    <div class="container-fluid dashboard-content">
        <div class="row">
            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 p-3 ml-3">
                <h2 class="text-primary mb-3">Add / remove user(s) from role</h2>
                <form method="post">
                    <div class="row">
                        <div class="col-md-6">
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                    <div>
                                        <input type="hidden" asp-for="@Model[i].RoleId" class="form-check-input" />
                                        <input type="hidden" asp-for="@Model[i].RoleName" class="form-check-input" />
                                        <input asp-for="@Model[i].IsSelected" class="form-check-input" />
                                        <label asp-for="@Model[i].IsSelected" class="form-check-label">
                                        @Model[i].RoleName
                                        </label>
                                    </div>
                            }
                        </div>                      
                    </div>
                    <div class="row -col-12 p-3">
                        <div class="btn-group" role="group" aria-label="Basic example">
                            <a asp-controller="Users" asp-route-id="@userId" asp-action="EditUserRole" class="btn btn-warning"><i class="fas fa-arrow-circle-left"></i>&nbsp;Cancel</a>
                            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i>&nbsp;Save</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
