@model IEnumerable<NationalCountyMeet.Web.Models.Others.ApplicationUser> 


@{
    ViewData["Title"] = "Index";
    Layout = "_SubLayout";
    int Counter = 1;
}

<div class="ecommerce-widget">
    <div class="row">
        <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
            <div class="card border-3 border-top border-top-primary">
                <div class="card-body">
                    <h5 class="text-muted">Total Registrations</h5>
                    <div class="metric-value d-inline-block">
                        <h1 class="mb-1">
                            @ViewBag.totalRegistrations
                        </h1>
                    </div>
                    <div class="metric-label d-inline-block float-right text-success font-weight-bold">
                        <span class="icon-circle-small icon-box-xs text-success bg-success-light"><i class="fa fa-fw fa-arrow-up"></i></span><span class="ml-1">5.86%</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
            <div class="card border-3 border-top border-top-primary">
                <div class="card-body">
                    <h5 class="text-muted">Male</h5>
                    <div class="metric-value d-inline-block">
                        <h1 class="mb-1">
                            @ViewBag.totalMale
                        </h1>
                    </div>
                    <div class="metric-label d-inline-block float-right text-success font-weight-bold">
                        <span class="icon-circle-small icon-box-xs text-success bg-success-light"><i class="fa fa-fw fa-arrow-up"></i></span><span class="ml-1">10%</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
            <div class="card border-3 border-top border-top-primary">
                <div class="card-body">
                    <h5 class="text-muted">Female</h5>
                    <div class="metric-value d-inline-block">
                        <h1 class="mb-1">
                            @ViewBag.totalFemale
                        </h1>
                    </div>
                    <div class="metric-label d-inline-block float-right text-success font-weight-bold">
                        <span class="icon-circle-small icon-box-xs text-success bg-success-light"><i class="fa fa-fw fa-arrow-up"></i></span><span class="ml-1">5%</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
            <div class="card border-3 border-top border-top-primary">
                <div class="card-body">
                    <h5 class="text-muted">Others</h5>
                    <div class="metric-value d-inline-block">
                        <h1 class="mb-1">
                            @ViewBag.others
                        </h1>
                    </div>
                    <div class="metric-label d-inline-block float-right text-danger font-weight-bold">
                        <span class="icon-circle-small icon-box-xs text-danger bg-danger-light bg-danger-light "><i class="fa fa-fw fa-arrow-down"></i></span><span class="ml-1">4%</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
        <div class="card">
            <div class="card-header">
                <div class="row col-md-12">
                    <div class="col-6 col-md-6">
                        <h3>User's Listing</h3>
                    </div>
                    <div class="col-6 col-md-6 p-0 text-right">
                        <a asp-controller="Users" asp-action="RegisterNewUser" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i>&nbsp;Add New</a>
                    </div>
                </div>
            </div>
            <div class="card-body">
                @if (Model.Any())
                {       
                    <div class="table-responsive">
                        <table id="example" class="table table-striped table-bordered second" style="width:100%">
                            <thead>
                                <tr>
                                    <th>
                                        No.
                                    </th>
                                    <th>
                                        Img
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.FullName)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.Age)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.Gender)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.PhoneNumber)
                                    </th>
                                    <th class="text-right">
                                        Actions
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            @String.Format("{0}", Counter++)
                                        </td>
                                        <td>
                                            <img src="~/images/default.jpg" style="width: 45px; height: 40px; border-radius: 100%;">
                                            @* <img src="@item.PlayerPhotoUrl" style="width: 45px; height: 40px; border-radius: 100%;"> *@
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.FullName)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Age)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Gender)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.PhoneNumber)
                                        </td>
                                        <td class="text-right">
                                            <a asp-controller="Users" asp-route-id="@item.Id" asp-action="UserDetails" class="btn btn-sm btn-light active"><i class="fas fa-eye"></i></a>
                                            <a asp-controller="Users" asp-route-id="@item.Id" asp-action="EditUser" class="btn btn-sm btn-success"><i class="far fa-edit"></i></a>
                                            <a asp-controller="Users" asp-route-id="@item.Id" asp-action="DeleteUser" class="btn btn-sm btn-danger"><i class="far fa-trash-alt"></i></a>
                                        </td>
                                    </tr>
                                }

                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-danger text-center">
                        No user created yet!!!
                    </div>
                }
            </div>
        </div>
    </div>
</div>