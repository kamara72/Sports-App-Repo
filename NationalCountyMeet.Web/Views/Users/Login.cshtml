@using NationalCountyMeet.Web.Models.Others
@model NationalCountyMeet.Web.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Manage User Roles";
    Layout = "_EmptyLayout";
}

<div class="card ">
    <div class="card-header text-center"><a href="../index.html"><img class="logo-img" src="../assets/images/logo.png" alt="logo"></a><span class="splash-description">Please enter your user information.</span></div>
    <div class="card-body">
        <form method="post">
            <div class="text-danger" asp-validation-summary="All"></div>
            <div class="form-group">
                <input class="form-control form-control-lg" id="username" asp-for="Email" placeholder="Username">
            </div>
            <div class="form-group">
                <input class="form-control form-control-lg" id="password" asp-for="Passsword" placeholder="Password">
            </div>
            <div class="form-group">
                <label class="custom-control custom-checkbox">
                    <input class="custom-control-input" asp-for="RememberMe"><span class="custom-control-label">Remember Me</span>
                </label>
            </div>
            <button type="submit" class="btn btn-primary btn-lg btn-block">Sign in</button>
        </form>
    </div>
    <div class="card-footer bg-white p-0  ">
        <div class="card-footer-item card-footer-item-bordered">
            <a href="#" class="footer-link">Create An Account</a>
        </div>
        <div class="card-footer-item card-footer-item-bordered">
            <a asp-controller="Users" asp-action="ForgotPassword" class="footer-link">Forgot Password</a>
        </div>
    </div>
</div>