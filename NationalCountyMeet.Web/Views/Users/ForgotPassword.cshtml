@using NationalCountyMeet.Web.Models.Others
@model NationalCountyMeet.Web.Models.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Manage User Roles";
    Layout = "_EmptyLayout";
}

<div class="card">
    <div class="card-header text-center"><img class="logo-img" src="../assets/images/logo.png" alt="logo"><span class="splash-description">Please enter your user information.</span></div>
    <div class="card-body">
        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <p>Don't worry, we'll send you an email to reset your password.</p>
            <div class="form-group">
                <input class="form-control form-control-lg" asp-for="Email" placeholder="Your Email">
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group pt-1"><button type="submit" class="btn btn-block btn-primary btn-xl" href="../index.html">Send</button></div>
        </form>
    </div>
    <div class="card-footer text-center">
        <span>Don't have an account? <a href="pages-sign-up.html">Sign Up</a></span>
    </div>
</div>