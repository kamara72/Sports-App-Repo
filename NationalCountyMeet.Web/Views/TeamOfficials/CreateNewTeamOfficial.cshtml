@using NationalCountyMeet.Web.Models.Others
@model NationalCountyMeet.Web.Models.TeamOfficial

@{
    ViewData["Title"] = "Create";
    Layout = "_SubLayout";
}

<div class="card">
    <h5 class="card-header">Add new team official</h5>
    <div class="card-body">
        <form asp-action="CreateNewTeamOfficial" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="FirstName" class="control-label"></label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="MiddleName" class="control-label"></label>
                        <input asp-for="MiddleName" class="form-control" />
                        <span asp-validation-for="MiddleName" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="LastName" class="control-label"></label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Gender" class="control-label"></label>
                        <select asp-for="Gender" asp-items="@Html.GetEnumSelectList<Gender>()" class="form-control"></select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="CountyId" class="control-label"></label>
                        <select asp-for="CountyId" asp-items="ViewBag.CountyId" class="form-control"></select>
                        <span asp-validation-for="CountyId" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Ethnicity" class="control-label"></label>
                        <select asp-for="Ethnicity" class="form-control" asp-items="@Html.GetEnumSelectList<Ethnicity>()"></select>
                        <span asp-validation-for="Ethnicity" class=" text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Official" class="control-label"></label>
                        <select asp-for="Official" class="form-control">
                            <option value="Coach">Coach</option>
                            <option value="Assistant Coach">Assistant Coach</option>
                            <option value="Doctor">Doctor/Medic</option>
                            <option value="Sponsor">Sponsor</option>
                            <option value="Others">Others</option>
                        </select>
                        <span asp-validation-for="Official" class=" text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Contact" class="control-label"></label>
                        <input asp-for="Contact" class="form-control" />
                        <span asp-validation-for="Contact" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Email" class="control-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="DateOfBirth" class="control-label"></label>
                        <input asp-for="DateOfBirth" class="form-control" />
                        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="PlaceOfBirth" class="control-label"></label>
                        <input asp-for="PlaceOfBirth" class="form-control" />
                        <span asp-validation-for="PlaceOfBirth" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <p></p>
                        <img id="playerImagePrv" src="~/images/default.jpg" width="230" height="160" />
                        <input asp-for="TeamOfficialPhoto" class="form-control" style="width: 230px;"
                               onchange="document.getElementById('playerImagePrv').src = window.URL.createObjectURL(this.files[0])" />
                        <span asp-validation-for="TeamOfficialPhoto" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="card-body border-top">
                <a asp-controller="TeamOfficials" asp-action="TeamOfficialsList" class="btn btn-dark"><i class="fas fa-arrow-circle-left"></i>&nbsp;Back to List</a>
                <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i>&nbsp;Save</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
