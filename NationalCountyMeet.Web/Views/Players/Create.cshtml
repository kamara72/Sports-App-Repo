@using NationalCountyMeet.Web.Models.Others
@model NationalCountyMeet.Web.Models.Player

@{
    ViewData["Title"] = "Create";
    Layout = "_SubLayout";
}

<div class="card">
    <h5 class="card-header">Player registration form</h5>
    <div class="card-body">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="FirstName" class="control-label"></label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="MiddleName" class="control-label"></label>
                        <input asp-for="MiddleName" class="form-control" />
                        <span asp-validation-for="MiddleName" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="LastName" class="control-label"></label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="DateOfBirth" class="control-label"></label>
                        <input asp-for="DateOfBirth" class="form-control"  />
                        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="CountyOfOriginCountyId" class="control-label"></label>
                        <select asp-for="CountyOfOriginCountyId" asp-items="ViewBag.CountyOfOriginCountyId" class="form-control"></select>
                        <span asp-validation-for="CountyOfOriginCountyId" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="JerseyNumber" class="control-label"></label>
                        <input asp-for="JerseyNumber" class="form-control" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="PlayerPosition" class="control-label"></label>
                        <input asp-for="PlayerPosition" class="form-control" />
                        <span asp-validation-for="PlayerPosition" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Contact" class="control-label"></label>
                        <input asp-for="Contact" class="form-control" />
                        <span asp-validation-for="Contact" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="HomeContact" class="control-label"></label>
                        <input asp-for="HomeContact" class="form-control" />
                        <span asp-validation-for="HomeContact" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Email" class="control-label"></label>
                        <input asp-for="Email" class="form-control" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="PlaceOfBirth" class="control-label"></label>
                        <input asp-for="PlaceOfBirth" class="form-control" />
                        <span asp-validation-for="PlaceOfBirth" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Gender" class="control-label"></label>
                        <select asp-for="Gender" asp-items="@Html.GetEnumSelectList<Gender>()" class="form-control"></select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="CountyId" class="control-label"></label>
                        <select asp-for="CountyId" asp-items="ViewBag.CountyId" class="form-control"></select>
                        <span asp-validation-for="CountyId" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Ethnicity" class="control-label"></label>
                        <select asp-for="Ethnicity" class="form-control" asp-items="@Html.GetEnumSelectList<Ethnicity>()"></select>
                        <span asp-validation-for="Ethnicity" class=" text-danger"></span>
                    </div>
                </div>    
                <div class="col-md-4"></div>
                <div class="col-md-3">
                    <div class="form-group">
                        @* <label asp-for="PlayerPhoto" class="control-label"></label> *@
                        <p></p>
                        <img id="playerImagePrv" src="~/images/default.jpg" width="230" height="160" />
                        <input asp-for="PlayerPhoto" class="form-control" style="width: 230px;"
                               onchange="document.getElementById('playerImagePrv').src = window.URL.createObjectURL(this.files[0])" />
                        <span asp-validation-for="PlayerPhoto" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-8 offset-1">
                    <div class="form-group">
                        <label asp-for="HomeAddress" class="control-label"></label>
                        <textarea asp-for="HomeAddress" onreset="false" style="height: 200px;" class="form-control"></textarea>
                    </div>
                </div>
            </div>
            <div class="card-body border-top">
                <a asp-controller="Players" asp-action="Index" class="btn btn-dark"><i class="fas fa-arrow-circle-left"></i>&nbsp;Back to List</a>
                <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i>&nbsp;Save</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        $(".custom-file-input").on("change", function(){
            var fileName = $(this).val().split("\\").pop();
            $(this).siblings(".custom-file-label").addClass("selected").html(fileName);
        });
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
